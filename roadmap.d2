direction: right

title: GoBank Roadmap {
  shape: text
  style.font-size: 28
  style.bold: true
}

classes: {
  item: { style.fill: "#fff3e0"; style.stroke: "#ff9800" }
  epic: { style.fill: "#e3f2fd"; style.stroke: "#2196f3"; style.font-size: 18; style.bold: true }
}

# Drawn from ROADMAP.md: the open items by epic. Shipped stories are in the changelog.
epics: {
  grid-columns: 4
  grid-gap: 16
  e1: "Transition to the target architecture" {
    class: epic
    grid-columns: 1
    uuid_columns: "UUID columns across the family" { class: item }
    simulation_tests: "Simulation becomes tests (ADR-0002 stage 9)" { class: item }
  }
  e2: "Products as versioned code" {
    class: epic
    grid-columns: 1
    bank_module: "The bank as a top-level module (ADR-0007)" { class: item }
    own_product: "A product of the bank's own" { class: item }
    remaining_events: "The remaining events: pre-posting, start-up, ma…" { class: item }
    parameter_history: "History of parameters and products" { class: item }
  }
  e3: "Users and access" {
    class: epic
    grid-columns: 1
    customers_as_users: "Customers as users" { class: item }
    permissions: "Permissions with the users" { class: item }
  }
  e4: "Speed" {
    class: epic
    grid-columns: 1
    measure: "Measure every route and named read" { class: item }
    gl_reads: "Reads move to the GL (ADR-0005)" { class: item }
    known_reads: "The known slow reads" { class: item }
    db_server: "The database on its own server" { class: item }
  }
  e5: "Mobile apps" {
    class: epic
    grid-columns: 1
    native_plugin: "Native security plugin" { class: item }
    device_signing: "Device-bound signing" { class: item }
    web_passkeys: "Passkeys on the web client" { class: item }
    app_shielding: "App-shielding SDK evaluation" { class: item }
    native_checkpoint: "Native checkpoint" { class: item }
    device_rendering: "Document rendering on the device" { class: item }
  }
  e6: "Payment rails" {
    class: epic
    grid-columns: 1
    rails: "Multiple payment rails, and one real rail" { class: item }
    payees: "Payee management" { class: item }
    mock_fps: "mock-fps integration" { class: item }
    fps_standin: "FPS stand-in mode" { class: item }
    unbundle_fps: "Unbundle mock-fps as a separate service" { class: item }
  }
  e7: "Workflows and lifecycles" {
    class: epic
    grid-columns: 1
    workflow_engine: "Workflow engine" { class: item }
    kyc: "KYC process" { class: item }
    lending_gateway: "Lending gateway" { class: item }
    savings_lifecycle: "Working savings accounts" { class: item }
    dormancy: "Dormancy and the account-number lifecycle" { class: item }
  }
  e8: "Customers" {
    class: epic
    grid-columns: 1
    customer_model: "Customer model" { class: item }
    customer_wall: "Named customers behind the customer wall" { class: item }
  }
  e9: "Finance and regulatory reporting" {
    class: epic
    grid-columns: 1
    period_reports: "Period accounting reports, produced and stored" { class: item }
    aeoi: "AEOI return prototype" { class: item }
    treasury_nim: "Treasury: cash at BoE and net interest margin" { class: item }
    risk_register: "Key and emerging risk register" { class: item }
    scv: "SCV regulatory report at scale" { class: item }
  }
  e10: "Performance and observability" {
    class: epic
    grid-columns: 1
    otel: "Observability with OpenTelemetry" { class: item }
    lock_telemetry: "Account locks in use" { class: item }
    load_tests: "Load tests in CI" { class: item }
  }
  e11: "Resilience" {
    class: epic
    grid-columns: 1
    restart_anywhere: "Restart the day at any point" { class: item }
    idempotent: "Idempotent commands" { class: item }
    fuzzing: "Fuzzing the inputs and the day" { class: item }
  }
  e12: "Delivery pipeline" {
    class: epic
    grid-columns: 1
    post_merge: "Post-merge automation" { class: item }
    pipeline_gates: "Performance and API documentation in the pipeli…" { class: item }
  }
  e13: "Blue-green deployment" {
    class: epic
    grid-columns: 1
    flags: "Feature flag component" { class: item }
    rw_split: "Read/write split" { class: item }
    many_processes: "Many processes" { class: item }
    bg_migrations: "Blue-green schema migrations" { class: item }
  }
  e14: "Kubernetes and AlloyDB" {
    class: epic
    grid-columns: 1
    k8s: "Deploy to a Kubernetes cluster" { class: item }
    alloydb: "AlloyDB backend" { class: item }
    full_api: "Full HTTP API for all GUI actions" { class: item }
  }
  e15: "Data governance" {
    class: epic
    grid-columns: 1
    lifetimes: "Data lifetimes as policy" { class: item }
    archive: "Archive and maintenance" { class: item }
    dbexplorer: "DB explorer on the pluggable go-dbexplorer" { class: item }
  }
  e16: "Bank migration" {
    class: epic
    grid-columns: 1
    luca_io: "Import and export via luca files" { class: item }
    export_account: "Export a single savings account" { class: item }
    import_bank: "Import another bank's book and run in parallel" { class: item }
    switchover: "Switch accounts over one at a time" { class: item }
  }
  e17: "A second bank" {
    class: epic
    grid-columns: 1
    second_definition: "Second definition module" { class: item }
    per_bank_presentation: "Per-bank presentation" { class: item }
    rbac_module: "Standalone RBAC module" { class: item }
  }
  e18: "Isle of Alba" {
    class: epic
    grid-columns: 1
    licence: "Bank licence trajectory" { class: item }
    regime: "The regime as data" { class: item }
  }
  e19: "Local process on the device" {
    class: epic
    grid-columns: 1
    device_reads: "The read side on the device" { class: item }
  }
  e20: "Distributed scale" {
    class: epic
    grid-columns: 1
    cockroach: "CockroachDB backend" { class: item }
    multi_region: "Multi-region deployment" { class: item }
  }
}
