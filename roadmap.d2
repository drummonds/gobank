direction: right

title: GoBank Roadmap {
  shape: text
  style.font-size: 28
  style.bold: true
}

classes: {
  done: { style.fill: "#c8e6c9"; style.stroke: "#4caf50" }
  todo: { style.fill: "#fff3e0"; style.stroke: "#ff9800" }
  epic: { style.fill: "#e3f2fd"; style.stroke: "#2196f3"; style.font-size: 18; style.bold: true }
}

legend: {
  grid-columns: 2
  done: Done { class: done }
  todo: To do { class: todo }
}

epics: {
  grid-columns: 4
  grid-gap: 16
  e1: "1 Transition to the target architecture" {
    class: epic
    grid-columns: 1
    s1_1: "1.1 Seams" { class: done }
    s1_2: "1.2 Stored truth" { class: done }
    s1_3: "1.3 Pipelined accruals" { class: done }
    s1_4: "1.4 Events and clock" { class: done }
    s1_5: "1.5 Core into packages" { class: done }
    s1_6: "1.6 One BFF" { class: done }
    s1_6a: "1.6a General ledger and sub-ledger (ADR-0005)" { class: todo }
    s1_7: "1.7 Users and access" { class: todo }
    s1_8: "1.8 Products as versioned code, with bitemporal" { class: todo }
    s1_9: "1.9 Speed" { class: todo }
    s1_10: "1.10 Performance and API documentation in the" { class: todo }
    s1_11: "1.11 Simulation becomes tests (ADR-0002 stage 9)" { class: todo }
  }
