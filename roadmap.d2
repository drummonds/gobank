direction: right

title: GoBank Roadmap {
  shape: text
  style.font-size: 28
  style.bold: true
}

legend: {
  grid-columns: 2
  done: Done {
    style.fill: "#c8e6c9"
    style.stroke: "#4caf50"
  }
  todo: To Do {
    style.fill: "#fff3e0"
    style.stroke: "#ff9800"
  }
}

phases: {
  grid-columns: 4
  grid-gap: 16

  phase1: Phase 1 — WASM Model Bank {
    grid-columns: 1
    style.fill: "#e3f2fd"
    style.stroke: "#2196f3"
    style.font-size: 18
    style.bold: true

    wasm: WASM build & deploy {
      style.fill: "#c8e6c9"
      style.stroke: "#4caf50"
    }
    lofigui: lofigui web UI {
      style.fill: "#c8e6c9"
      style.stroke: "#4caf50"
    }
    goluca: go-luca accounting integration {
      style.fill: "#c8e6c9"
      style.stroke: "#4caf50"
    }
    rbac: RBAC (admin role) {
      style.fill: "#c8e6c9"
      style.stroke: "#4caf50"
    }
    savings: Working savings accounts {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    import: Import state via luca files {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    export: Export state via luca files {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    export_single: Export single savings account {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    pnl: Accurate P&L (EOD + periods) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    bs: Balance sheet (EOD + periods) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    customers: Customer model (confidence, max agg balance) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    customer_wall: Named customers behind customer wall {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    mock_fps: mock-fps integration (compiled in) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    standin: FPS stand-in mode simulation {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
  }

  phase2: Phase 2 — Mobile: Go BFF + Flutter {
    grid-columns: 1
    style.fill: "#e0f2f1"
    style.stroke: "#009688"
    style.font-size: 18
    style.bold: true

    screen: Screen layer (JSON + HTML) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    bff: Hardened Go BFF (auth first) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    flutter: Flutter thin shell (iOS + Android) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    core_extract: Extract banking core from cmd/demo {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    demo_screens: Demo phone frame on screen layer {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    sec_plugin: Native security plugin (Swift + Kotlin) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    attest: Biometric keys, passkeys, attestation {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    stepup: Device-bound signing + step-up auth (SCA) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    web_bff: Web client on the same BFF {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    shield: App-shielding SDK before pilot {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    native_check: Native checkpoint after pilot {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
  }

  phase3: Phase 3 — Kubernetes + AlloyDB {
    grid-columns: 1
    style.fill: "#f3e5f5"
    style.stroke: "#9c27b0"
    style.font-size: 18
    style.bold: true

    k8s: Deploy to Kubernetes cluster {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    alloydb: AlloyDB (Postgres) backend {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    multi_svc: Unbundle mock-fps as separate service {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    http_api: Full HTTP API (all GUI actions) {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    scv: SCV regulatory report at scale {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
  }

  phase4: Phase 4 — CockroachDB + Scale {
    grid-columns: 1
    style.fill: "#fce4ec"
    style.stroke: "#e91e63"
    style.font-size: 18
    style.bold: true

    crdb: CockroachDB backend {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    multi_region: Multi-region deployment {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
    blue_green: Blue-green schema migrations {
      style.fill: "#fff3e0"
      style.stroke: "#ff9800"
    }
  }
}

phases.phase1 -> phases.phase2: Logic moves server-side, thin clients
phases.phase2 -> phases.phase3: Same code, different deployment
phases.phase3 -> phases.phase4: Scale out
