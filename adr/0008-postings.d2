direction: right

classes: {
  asset: {style: {fill: "#d9ead3"; stroke: "#6aa84f"}}
  liability: {style: {fill: "#f4cccc"; stroke: "#cc0000"}}
  equity: {style: {fill: "#fff2cc"; stroke: "#bf9000"}}
  income: {style: {fill: "#cfe2f3"; stroke: "#3d85c6"}}
  expense: {style: {fill: "#ead1dc"; stroke: "#a64d79"}}
}

today: "Today: signed by the direction each event happened to be written in" {
  equity: "Equity:Capital\n−1,800.00" {class: equity}
  savings: "Liability:Savings:alice\n+1,001.27" {class: liability}
  loans: "Asset:Loans:bob\n+804.69" {class: asset}
  expense: "Expense:Interest\n−1.27" {class: expense}
  income: "Income:Interest\n−4.69" {class: income}

  equity -> savings: "1,000.00 deposit"
  equity -> loans: "800.00 drawdown"
  expense -> savings: "1.27 interest applied"
  income -> loans: "4.69 interest applied"
}

decided: "Decided: the bank's view — a movement runs from the account credited to the account debited" {
  cash: "Asset:Cash\n+200.00" {class: asset}
  savings: "Liability:Savings:alice\n−1,001.27" {class: liability}
  loans: "Asset:Loans:bob\n+804.69" {class: asset}
  expense: "Expense:Interest\n+1.27" {class: expense}
  income: "Income:Interest\n−4.69" {class: income}
  equity: "Equity:Capital\n0.00" {class: equity}

  savings -> cash: "1,000.00 deposit"
  cash -> loans: "800.00 drawdown"
  savings -> expense: "1.27 interest applied"
  income -> loans: "4.69 interest applied"
}

today -> decided: "ADR-0008" {style.stroke-dash: 3}
